# Copy to .env.local for local development. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_matching_test_key_secret

# Use the Neon PostgreSQL URL provided for this project. URL-encode special
# characters in the password and retain the SSL parameters supplied by Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
